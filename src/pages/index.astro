---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Vincent.">
  <!--
    Nixpacks serves this file for every path that is not a file or a "/"-ending
    directory. Add the missing slash, or send the visitor to the 404 page.
  -->
  <script is:inline slot="head">
    (function () {
      const path = window.location.pathname;
      if (path === "/" || path === "/index.html") return;
      if (path.endsWith("/")) {
        window.location.replace("/404.html");
      } else {
        window.location.replace(
          path + "/" + window.location.search + window.location.hash,
        );
      }
    })();
  </script>

  <section>
    <p class="font-display text-2xl">
      Vincent Kwaku{" "}
      <span>
        Kpemlie<span class="text-green-700">.</span>
      </span>
    </p>
    <div>
      <p class="font-mono">Software Engineer.</p>
    </div>
    <div></div>
  </section>

  <section class="py-8 font-mono">
    <p class="">
      I enjoy solving problems, building interfaces and figuring out how things
      work. I am experienced in building beautiful and functional web and mobile
      applications as well as backend systems. I am interested in software,
      hardware and most things in between.
      <br />
      <br />
      <span>
        outside of software and computers I enjoy cooking and farming.</span
      >
    </p>
  </section>

  <section class="flex flex-col">
    <a
      href="/projects/"
      class="link-underline self-start font-display text-base"
    >
      see my projects <span class="font-mono">↗</span>
    </a>
    <a href="/blog/" class="link-underline self-start font-display text-base">
      see my blog <span class="font-mono">↗</span>
    </a>
    <a
      href="/vkkpemlie_resume.pdf"
      class="link-underline self-start font-display text-base"
    >
      check out my resume <span class="font-mono">↗</span>
    </a>
  </section>
</BaseLayout>
