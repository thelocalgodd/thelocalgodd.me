---
import { render } from "astro:content"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { formatPostDate, getAllPosts, readingTime, type Post } from "../../lib/blog"

export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

interface Props {
  post: Post
}

const { post } = Astro.props
const { Content } = await render(post)
---

<BaseLayout
  title={`${post.data.title} | Vincent.`}
  metaTitle={post.data.title}
  description={post.data.description}
  publishedAt={post.data.date}
  image={`/og/${post.id}.png`}
>
  <article>
    <header class="mb-8">
      <a href="/blog/" class="link-underline font-mono text-xs text-green-700">
        ‹ blog.
      </a>
      <h1 class="mt-4 font-display text-3xl">{post.data.title}</h1>
      <p class="mt-3 font-mono text-xs text-black/55">
        {formatPostDate(post.data.date)} · {readingTime(post)}
      </p>
      {post.data.tags.length > 0 && (
        <div class="mt-2 flex gap-2">
          {post.data.tags.map((tag) => (
            <span class="font-mono text-xs text-green-700">#{tag}</span>
          ))}
        </div>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<script>
  const COPIED_MS = 1500

  // Add a copy button to each code block. Runs again after each client-side page change.
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
      const wrapper = document.createElement("div")
      wrapper.className = "relative"
      pre.replaceWith(wrapper)
      wrapper.append(pre)

      const button = document.createElement("button")
      button.type = "button"
      button.textContent = "copy"
      button.setAttribute("aria-label", "copy code")
      button.className =
        "absolute top-2 right-2 border border-black/15 bg-[#fdf0da] px-2 py-0.5 font-mono text-xs opacity-60 transition-opacity hover:opacity-100 focus-visible:opacity-100"
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText)
          button.textContent = "copied"
        } catch (error) {
          button.textContent = "copy failed"
          console.error("Copy to clipboard failed", error)
        }
        window.setTimeout(() => { button.textContent = "copy" }, COPIED_MS)
      })
      wrapper.append(button)
    })
  })
</script>
