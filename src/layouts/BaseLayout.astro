---
import "../styles/global.css"
import Footer from "../components/Footer.astro"
import NavBar from "../components/NavBar.astro"
import Toast from "../components/Toast"

interface Props {
  title?: string
  fullscreen?: boolean
}

const { title = "Vincent.", fullscreen = false } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Primary Meta Tags -->
    <meta name="title" content="thelocalgodd.me" />
    <meta name="description" content="Personal site of thelocalgodd." />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://thelocalgodd.me/" />
    <meta property="og:title" content="thelocalgodd.me" />
    <meta property="og:description" content="Personal site of thelocalgodd." />
    <meta property="og:image" content="/meta-image.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://thelocalgodd.me/" />
    <meta name="twitter:title" content="thelocalgodd.me" />
    <meta name="twitter:description" content="Personal site of thelocalgodd." />
    <meta name="twitter:image" content="/meta-image.png" />

    <script
      is:inline
      defer
      src="https://analytics.thelocalgodd.me/script.js"
      data-website-id="2f2afe4c-d098-4da8-9441-d82754df8753"></script>

    <slot name="head" />
  </head>

  <body>
    <div
      class={fullscreen
        ? "mx-auto flex min-h-svh w-full max-w-[1000px] flex-col px-6 py-6 md:h-screen md:max-w-[800px] md:overflow-hidden lg:max-w-[900px]"
        : "mx-auto w-full max-w-[1000px] px-6 py-6 md:max-w-[800px] lg:max-w-[900px]"}
    >
      <NavBar />
      <main class={fullscreen ? "flex flex-1 flex-col md:min-h-0" : undefined}><slot /></main>
      <Footer />
      <Toast client:only="react" />
    </div>
  </body>
</html>
